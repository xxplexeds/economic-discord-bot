# Discord
DISCORD_TOKEN=
# Optional: set this to your development server ID for instant guild command sync.
DISCORD_GUILD_ID=
# Required for the single-server dashboard. May match DISCORD_GUILD_ID.
RELEASE_GUILD_ID=

# PostgreSQL
# Use the Railway-provided URL or a local PostgreSQL URL.
DATABASE_URL=

# API
API_HOST=0.0.0.0
API_PORT=8000
DASHBOARD_API_URL=http://localhost:8000
DASHBOARD_FRONTEND_URL=http://localhost:3000

# Discord OAuth2 dashboard login (create an app in the Discord Developer Portal)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Generate a random secret with at least 32 characters; never share or commit it.
DASHBOARD_SESSION_SECRET=

# Next.js browser API origin; set this in the web service environment.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Currency display
CURRENCY_NAME=Fihcoins
CURRENCY_EMOJI=<:fihcoin:1575710572907987064>
